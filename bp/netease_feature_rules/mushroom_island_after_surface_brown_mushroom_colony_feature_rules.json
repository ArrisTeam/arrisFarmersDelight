{
  "format_version": "1.14.0",
  "minecraft:feature_rules": {
    "conditions": {
      "placement_pass": "after_surface_pass",
      "minecraft:biome_filter": [
        {
          "any_of": [
            {
              "test": "has_biome_tag",
              "value": "overworld"
            },
            {
              "test": "has_biome_tag",
              "value": "overworld_generation"
            }
          ]
        },
        {
          "test": "has_biome_tag",
          "value": "mooshroom_island"
        }
      ]
    },
    "description": {
      "identifier": "arris:mushroom_island_after_surface_brown_mushroom_colony_feature_rules",
      "places_feature": "arris:patch_brown_mushroom_colony_feature"
    },
    "distribution": {
      "iterations": 1,
      "scatter_chance": {
        "numerator": 1,
        "denominator": 15
      },
      "x": {
        "distribution": "uniform",
        "extent": [ 0, 16 ]
      },
      "y": "query.heightmap(variable.worldx, variable.worldz)",
      "z": {
        "distribution": "uniform",
        "extent": [ 0, 16 ]
      }
    }
  }
}
