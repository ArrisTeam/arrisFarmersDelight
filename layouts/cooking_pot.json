{
  // 厨锅（Shared/Menus/CookingPot.py 的 arris:cooking_pot）。vendor 时由 dolorContainer 的 tools/layouts.py 编译成
  // rp/ui/dolor_layout_arrisfarmersdelightscripts_arris_cooking_pot.json 与脚本根下的 dolorLayouts.py（都不手改）。
  // 照旧界面（rp/ui/arrisCookingPot.json）的样子：三块并排、顶对齐、都高 175，整体在屏幕正中——
  // 左边是食谱选择（搜索框，下面是按搜索过滤的食谱图标格，放不下才滚动），中间是厨锅（3 × 2 食材格、火焰、进度箭头、预览框、
  // 容器格与成品格）和玩家物品栏，右边是选中食谱的详情（标题、食材格、朝下的箭头、勺子与容器格、锅形预览框里的成品、火焰、
  // "+"按钮与下面的"添加食材"，后两样选了食谱才有）。背后垫一张原版配方书的底（recipe_back_panel，比中间那块左右各多 10），
  // 两边的侧栏各压进去 7，三块之间露出 3 宽的深色折缝；点在折缝与侧栏空白处不算点在界面外面（不会把手上的东西丢出去）。
  // 经典版与携带版用同一个内容模板（携带版照原版压暗背后）：携带版的物品栏同样是快捷栏 + 主背包两个格子区，界面模型的去向表两种界面档一样。
  // 字写的是语言文件的键（rp/texts 的 arris_fd.pot_screen.*）：搜索框的提示由引擎的文字控件查，"添加食材"由库在客户端按玩家的语言查；
  // 英文的宽度照默认字体估过（tests/test_pot_screen_texts.py）。
  "namespace": "arris_cooking_pot",
  "$dc_layout": "arris:cooking_pot",
  "$dc_menu": "arris:cooking_pot",
  "$dc_screens": {"classic": "pot_classic", "pocket": "pot_pocket"},

  "pot_classic@dc.screen_classic": {"$dc_content": "arris_cooking_pot.content"},
  "pot_pocket@dc.screen_pocket": {"$dc_content": "arris_cooking_pot.content", "$dc_dim": true},

  // ---------------------------------------------------------------- 共用的小件

  "note": {
    "type": "label",
    "text": "",
    "color": [0.25, 0.25, 0.25],
    "localize": false,
    "layer": 2,
    "anchor_from": "top_left",
    "anchor_to": "top_left"
  },
  // 火焰：底图一直画着，下面有热源时盖上亮的那张（界面数据 heated）
  "heat": {
    "type": "image",
    "texture": "textures/ui/fire_icon",
    "size": [18, 16],
    "layer": 2,
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "controls": [
      {"lit": {"type": "image", "texture": "textures/ui/heat", "size": ["100%", "100%"], "layer": 1,
               "anchor_from": "top_left", "anchor_to": "top_left", "$dc_visible": "heated"}}
    ]
  },
  // 进度箭头：灰的底，白的按烹饪进度（界面数据 progress）从左往右长
  "progress": {
    "type": "panel",
    "size": [22, 15],
    "layer": 2,
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "controls": [
      {"empty": {"type": "image", "texture": "textures/ui/arrow", "size": [22, 15], "layer": 1,
                 "anchor_from": "top_left", "anchor_to": "top_left"}},
      {"full": {"type": "image", "texture": "textures/ui/arrow_active", "size": [22, 15], "layer": 3,
                "anchor_from": "top_left", "anchor_to": "top_left", "clip_direction": "left", "clip_ratio": 1.0,
                "$dc_data": "progress"}}
    ]
  },
  // 预览框：煮好、还没装进容器的成品（界面数据 preview）；size 是框，里面的物品图标另摆
  "preview_frame": {
    "type": "image",
    "texture": "textures/ui/preview",
    "size": [38, 38],
    "layer": 1,
    "anchor_from": "top_left",
    "anchor_to": "top_left"
  },
  // 三块之间的折缝：透明的一条，吃掉点在上面的点击（深色是背后垫的那张配方书底露出来的）
  "fold": {
    "type": "input_panel",
    "size": [3, 175],
    "layer": 1,
    "button_mappings": "$dc_panel_mappings"
  },

  // ---------------------------------------------------------------- 内容（两种界面档共用）

  "content": {
    "type": "panel",
    "size": ["100%", "100%"],
    "controls": [
      {"back": {
        "type": "image", "texture": "textures/ui/recipe_back_panel", "size": [196, 168], "layer": 0,
        "anchor_from": "center", "anchor_to": "center"
      }},
      {"row": {
        "type": "stack_panel",
        "orientation": "horizontal",
        "size": ["100%c", 175],
        "anchor_from": "center",
        "anchor_to": "center",
        "controls": [
          {"recipes@arris_cooking_pot.recipes_side": {}},
          {"fold_left@arris_cooking_pot.fold": {}},
          {"panel@dc.panel_classic": {
            "size": [176, 175],
            "controls": [
              {"bg@common.common_panel": {"$close_button_to_button_id": "#dc.close"}},
              {"body": {
                "type": "panel",
                "layer": 5,
                "size": ["100%", "100%"],
                "controls": [
                  // 标题的框收到关闭按钮左边（库的缺省是面板宽的 90%，压到右上角的关闭按钮上）
                  {"title@dc.title": {"offset": [7, 6], "size": [140, "default"]}},
                  {"ingredients@dc.grid_classic": {
                    "$dc_name": "ingredients", "$dc_collection": "ingredients", "$dc_columns": 3, "$dc_rows": 2,
                    "$dc_focus": true, "offset": [22, 22], "layer": 2
                  }},
                  {"heat@arris_cooking_pot.heat": {"offset": [40, 62]}},
                  {"progress@arris_cooking_pot.progress": {"offset": [82, 32]}},
                  {"preview_frame@arris_cooking_pot.preview_frame": {"offset": [112, 18]}},
                  {"preview@dc.item_classic": {
                    "$dc_item": "preview", "anchor_from": "top_left", "anchor_to": "top_left", "offset": [122, 28], "layer": 2
                  }},
                  {"vessel@dc.slot_classic": {
                    "$dc_name": "vessel", "$dc_collection": "vessel", "$dc_placeholder_size": [14, 14],
                    "offset": [114, 62], "layer": 2
                  }},
                  {"output@dc.slot_large_classic": {
                    "$dc_name": "output", "$dc_collection": "output", "offset": [140, 58], "layer": 2
                  }},
                  {"inventory@dc.player_inventory_classic": {
                    "anchor_from": "bottom_left", "anchor_to": "top_left", "offset": [7, -90]
                  }}
                ]
              }}
            ]
          }},
          {"fold_right@arris_cooking_pot.fold": {}},
          {"details@arris_cooking_pot.details_side": {}}
        ]
      }}
    ]
  },

  // 左边：食谱选择。底图照旧界面原样拉伸（浅色边框 + 深色凹槽），搜索框在凹槽顶上、右边一个放大镜；下面是食谱格：
  // 一格一道菜的成品（库的 Choice，点一格选中，选中的那格一直是选中的底格），4 列，按行回收（下游模组追加多少道都是这些控件），
  // 放不下才出现滚动条（在格子右边、压在侧栏的边框上），不画滚动面板的底
  "recipes_side": {
    "type": "input_panel",
    "size": [83, 175],
    "layer": 1,
    "button_mappings": "$dc_panel_mappings",
    "controls": [
      {"bg": {"type": "image", "texture": "textures/ui/tutorial_book_screen_ui", "size": ["100%", "100%"], "keep_ratio": false,
              "layer": 0}},
      {"search@dc.text_box": {
        "$dc_action": "search", "$dc_value": "search", "$dc_live": true, "$dc_placeholder": "arris_fd.pot_screen.search",
        "$place_holder_text_color": [0.5, 0.5, 0.5],
        "size": [74, 20], "anchor_from": "top_left", "anchor_to": "top_left", "offset": [4, 8], "layer": 2
      }},
      {"glass": {
        "type": "image", "texture": "textures/ui/magnifyingGlass", "size": [15, 15], "layer": 4,
        "anchor_from": "top_left", "anchor_to": "top_left", "offset": [61, 10.5]
      }},
      {"grid@dc.scroll_grid_classic": {
        "$dc_name": "recipe_grid", "$dc_collection": "recipes", "$dc_columns": 4, "$dc_pool_rows": 12, "$dc_shown_rows": 8,
        "$dc_fixed_columns": true, "$dc_scroll_style": "container",
        "$dc_cell_texture": "textures/ui/recipe_book_item_bg",
        "anchor_from": "top_left", "anchor_to": "top_left", "offset": [5, 28], "size": [77, 138], "layer": 2,
        "$show_background": false,
        "$scroll_bar_left_padding_size": [1, 0],
        "$scroll_view_port_size": ["100%", "100%"],
        "$scroll_view_port_offset": [0, 0],
        "$scrolling_pane_size_touch": ["100%", "100%"],
        "$scroll_view_port_size_touch": ["100%", "100%"],
        "$scroll_view_port_offset_touch": [0, 0],
        "$scroll_size_touch": [4, "100%"],
        "$wider_scroll_area": false
      }}
    ]
  },

  // 右边：选中食谱的详情，摆法照旧界面的 cookbook_bg。标题在上面 22 高的一条里居中（长名字折成两行，再长也压不到食材格）；
  // 食材格每秒换一种写法（服务端按钟算好发来）；成品画在锅形预览框里（框底下的小三角裁掉）；火焰是常亮的示意
  "details_side": {
    "type": "input_panel",
    "size": [83, 175],
    "layer": 1,
    "button_mappings": "$dc_panel_mappings",
    "controls": [
      {"bg": {"type": "image", "texture": "textures/ui/dialog_background_opaque", "size": ["100%", "100%"], "layer": 0}},
      {"title_band": {
        "type": "panel", "size": [75, 22], "layer": 2, "clips_children": true,
        "anchor_from": "top_middle", "anchor_to": "top_middle", "offset": [0, 0],
        "controls": [
          {"title@arris_cooking_pot.note": {
            "$dc_format": "{bookTitle}", "size": [75, "default"], "text_alignment": "center",
            "color": [0.208, 0.208, 0.208], "anchor_from": "center", "anchor_to": "center", "offset": [0, 1]
          }}
        ]
      }},
      {"cells@dc.grid_classic": {
        "$dc_name": "book_in", "$dc_collection": "book", "$dc_columns": 3, "$dc_rows": 2,
        "anchor_from": "top_middle", "anchor_to": "top_middle", "offset": [0, 22], "layer": 2
      }},
      {"arrow": {
        "type": "image", "texture": "textures/ui/arrow_active", "size": [22, 15], "rotate_angle": -90.0, "layer": 2,
        "anchor_from": "top_middle", "anchor_to": "top_middle", "offset": [0, 63.5]
      }},
      {"spoon": {
        "type": "image", "texture": "textures/ui/spoon", "size": [14, 14], "layer": 2,
        "anchor_from": "top_left", "anchor_to": "top_left", "offset": [9.5, 77]
      }},
      {"book_vessel@dc.slot_classic": {
        "$dc_name": "book_vessel", "$dc_collection": "book", "$dc_index": 6, "offset": [7.5, 93], "layer": 2
      }},
      {"result_frame": {
        "type": "image", "texture": "textures/ui/preview", "size": [38, 38], "clip_direction": "up", "clip_ratio": 0.13,
        "layer": 1, "anchor_from": "top_middle", "anchor_to": "top_middle", "offset": [0, 83]
      }},
      {"result@dc.item_classic": {
        "$dc_item": "bookResult", "anchor_from": "top_middle", "anchor_to": "top_middle", "offset": [0, 95], "layer": 2
      }},
      {"fire": {
        "type": "image", "texture": "textures/ui/heat", "size": [18, 18], "layer": 2,
        "anchor_from": "top_middle", "anchor_to": "top_middle", "offset": [0, 117]
      }},
      {"add_panel": {
        "type": "panel", "size": ["100%", "100%"], "layer": 2, "visible": false, "$dc_visible": ["picked", "!=", -1],
        "controls": [
          {"add@dc.button": {
            "$dc_action": "addFood",
            "$dc_button_default": "textures/ui/use_recipe_up_ui", "$dc_button_hover": "textures/ui/use_recipe_down_ui",
            "$dc_button_pressed": "textures/ui/use_recipe_down_ui",
            "size": [17, 17], "anchor_from": "top_middle", "anchor_to": "top_middle", "offset": [0.5, 136.5], "layer": 1
          }},
          {"add_note@arris_cooking_pot.note": {
            "$dc_format": "arris_fd.pot_screen.add_food", "size": [79, "default"], "text_alignment": "center",
            "color": [0.247, 0.247, 0.247], "anchor_from": "top_middle", "anchor_to": "top_middle", "offset": [0.5, 157.5]
          }}
        ]
      }}
    ]
  }
}
