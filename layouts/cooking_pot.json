{
  // 厨锅（Shared/Menus/CookingPot.py 的 arris:cooking_pot）。vendor 时由 dolorContainer 的 tools/layouts.py 编译成
  // rp/ui/dolor_layout_arrisfarmersdelightscripts_arris_cooking_pot.json 与脚本根下的 dolorLayouts.py（都不手改）。
  // 经典版：中间是厨锅（左边 3 × 2 食材格，下面是火焰，中间进度箭头，右边预览框、容器格与成品格），下面是玩家物品栏；
  // 左边的侧栏是选中食谱的详情（食材、容器、成品、换变体、添加食材），右边的侧栏是食谱列表（带搜索框），与旧界面的位置一样。
  // 携带版：照原版携带版的整屏界面，左半屏物品栏，右半屏两页——"烹饪"（厨锅）与"食谱"（列表与详情），页签切换。
  "namespace": "arris_cooking_pot",
  "$dc_layout": "arris:cooking_pot",
  "$dc_menu": "arris:cooking_pot",
  "$dc_screens": {"classic": "pot_classic", "pocket": "pot_pocket"},

  "pot_classic@dc.screen_classic": {"$dc_content": "arris_cooking_pot.classic_content"},
  "pot_pocket@dc.screen_pocket": {"$dc_content": "arris_cooking_pot.pocket_content"},

  // ---------------------------------------------------------------- 共用的小件

  "note": {
    "type": "label",
    "text": "",
    "color": [0.25, 0.25, 0.25],
    "localize": false,
    "layer": 2,
    "anchor_from": "top_left",
    "anchor_to": "top_left"
  },
  // 火焰：底图一直画着，下面有热源时盖上亮的那张（界面数据 heated）
  "heat": {
    "type": "image",
    "texture": "textures/ui/fire_icon",
    "size": [18, 16],
    "layer": 2,
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "controls": [
      {"lit": {"type": "image", "texture": "textures/ui/heat", "size": ["100%", "100%"], "layer": 1,
               "anchor_from": "top_left", "anchor_to": "top_left", "$dc_visible": "heated"}}
    ]
  },
  // 进度箭头：灰的底，白的按烹饪进度（界面数据 progress）从左往右长
  "progress": {
    "type": "panel",
    "size": [22, 15],
    "layer": 2,
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "controls": [
      {"empty": {"type": "image", "texture": "textures/ui/arrow", "size": [22, 15], "layer": 1,
                 "anchor_from": "top_left", "anchor_to": "top_left"}},
      {"full": {"type": "image", "texture": "textures/ui/arrow_active", "size": [22, 15], "layer": 3,
                "anchor_from": "top_left", "anchor_to": "top_left", "clip_direction": "left", "clip_ratio": 1.0,
                "$dc_data": "progress"}}
    ]
  },
  // 预览框：煮好、还没装进容器的成品（界面数据 preview）；size 是框，里面的物品图标另摆
  "preview_frame": {
    "type": "image",
    "texture": "textures/ui/preview",
    "size": [38, 38],
    "layer": 1,
    "anchor_from": "top_left",
    "anchor_to": "top_left"
  },

  // ---------------------------------------------------------------- 经典版

  "classic_content": {
    "type": "panel",
    "size": ["100%", "100%"],
    "controls": [
      {"panel@dc.panel_classic": {
        "size": [176, 175],
        "controls": [
          {"bg@common.common_panel": {"$close_button_to_button_id": "#dc.close"}},
          {"body": {
            "type": "panel",
            "layer": 5,
            "size": ["100%", "100%"],
            "controls": [
              {"title@dc.title": {"offset": [7, 6]}},
              {"ingredients@dc.grid_classic": {
                "$dc_name": "ingredients", "$dc_collection": "ingredients", "$dc_columns": 3, "$dc_rows": 2,
                "$dc_focus": true, "offset": [22, 22], "layer": 2
              }},
              {"heat@arris_cooking_pot.heat": {"offset": [40, 62]}},
              {"progress@arris_cooking_pot.progress": {"offset": [82, 32]}},
              {"preview_frame@arris_cooking_pot.preview_frame": {"offset": [112, 18]}},
              {"preview@dc.item_classic": {
                "$dc_item": "preview", "anchor_from": "top_left", "anchor_to": "top_left", "offset": [122, 28], "layer": 2
              }},
              {"vessel@dc.slot_classic": {
                "$dc_name": "vessel", "$dc_collection": "vessel", "$dc_placeholder_size": [14, 14],
                "offset": [114, 62], "layer": 2
              }},
              {"output@dc.slot_large_classic": {
                "$dc_name": "output", "$dc_collection": "output", "offset": [140, 58], "layer": 2
              }},
              {"inventory@dc.player_inventory_classic": {
                "anchor_from": "bottom_left", "anchor_to": "top_left", "offset": [7, -90]
              }}
            ]
          }},
          // 左侧栏：选中食谱的详情；右侧栏：食谱列表。点在侧栏空白处不算点在界面外面（不会把手上的东西丢出去）
          {"details@arris_cooking_pot.details_side": {"anchor_from": "top_left", "anchor_to": "top_right"}},
          {"recipes@arris_cooking_pot.recipes_side": {"anchor_from": "top_right", "anchor_to": "top_left"}}
        ]
      }}
    ]
  },

  "details_side": {
    "type": "input_panel",
    "size": [83, 175],
    "layer": 1,
    "button_mappings": "$dc_panel_mappings",
    "controls": [
      {"bg@common.common_panel": {"$show_close_button": false}},
      {"title@arris_cooking_pot.note": {
        "$dc_format": "{bookTitle}", "size": [75, "default"], "text_alignment": "center",
        "anchor_from": "top_middle", "anchor_to": "top_middle", "offset": [0, 8]
      }},
      {"cells@dc.grid_classic": {
        "$dc_name": "book_in", "$dc_collection": "book", "$dc_columns": 3, "$dc_rows": 2, "offset": [14, 24], "layer": 2
      }},
      {"book_vessel@dc.slot_classic": {
        "$dc_name": "book_vessel", "$dc_collection": "book", "$dc_index": 6, "offset": [10, 68], "layer": 2
      }},
      {"book_arrow": {
        "type": "image", "texture": "textures/ui/arrow", "size": [22, 15], "layer": 2,
        "anchor_from": "top_left", "anchor_to": "top_left", "offset": [33, 69]
      }},
      {"book_result@dc.slot_classic": {
        "$dc_name": "book_result", "$dc_collection": "book", "$dc_index": 7, "offset": [56, 68], "layer": 2
      }},
      {"variant@arris_cooking_pot.note": {
        "$dc_format": "{bookVariant}", "size": [75, "default"], "text_alignment": "center",
        "anchor_from": "top_middle", "anchor_to": "top_middle", "offset": [0, 94]
      }},
      {"next@dc.button": {
        "$dc_action": "nextVariant", "$dc_label": "换一种配方", "$dc_visible": ["picked", "!=", -1],
        "size": [65, 16], "anchor_from": "top_left", "anchor_to": "top_left", "offset": [9, 128], "layer": 2
      }},
      {"add@dc.button": {
        "$dc_action": "addFood", "$dc_label": "添加食材", "$dc_visible": ["picked", "!=", -1],
        "size": [65, 16], "anchor_from": "top_left", "anchor_to": "top_left", "offset": [9, 150], "layer": 2
      }}
    ]
  },

  "recipes_side": {
    "type": "input_panel",
    "size": [83, 175],
    "layer": 1,
    "button_mappings": "$dc_panel_mappings",
    "controls": [
      {"bg@common.common_panel": {"$show_close_button": false}},
      {"search@dc.text_box": {
        "$dc_action": "search", "$dc_value": "search", "$dc_live": true, "$dc_placeholder": "搜索食谱",
        "size": [67, 14], "anchor_from": "top_left", "anchor_to": "top_left", "offset": [8, 8], "layer": 2
      }},
      {"recipe_list@arris_cooking_pot.recipe_list": {"offset": [4, 28]}}
    ]
  },

  // 食谱列表：一行一个食谱（成品的图标与名字），点一行选中（经可预测的动作，选中的序号记在每位查看者的状态 picked）
  "recipe_list": {
    "type": "panel",
    "size": [75, 138],
    "layer": 2,
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "controls": [
      {"list@dc.list": {
        "$dc_items": "recipes", "$dc_value": "picked", "$dc_key": "index", "$dc_action": "pick", "$dc_row_height": 18,
        "size": [75, 138], "anchor_from": "top_left", "anchor_to": "top_left", "layer": 2,
        "controls": [
          {"icon@dc.item_classic": {
            "$dc_item": "value", "anchor_from": "left_middle", "anchor_to": "left_middle", "offset": [1, 0]
          }},
          {"name@arris_cooking_pot.note": {
            "$dc_format": "{value:name}", "anchor_from": "left_middle", "anchor_to": "left_middle", "offset": [21, 0]
          }}
        ]
      }}
    ]
  },

  // ---------------------------------------------------------------- 携带版

  "half": {
    "type": "panel",
    "size": ["50%", "100%-27px"],
    "offset": [0, 27],
    "layer": 1,
    "anchor_to": "top_left"
  },
  "half_inner": {
    "type": "panel",
    "size": ["80%", "95%"],
    "anchor_from": "center",
    "anchor_to": "center"
  },

  "pocket_content": {
    "type": "panel",
    "size": ["100%", "100%"],
    "controls": [
      {"bg": {"type": "image", "texture": "textures/ui/background_panel", "size": ["100%", "100%"], "layer": 0}},
      {"header": {
        "type": "panel",
        "size": ["100%", "100%"],
        "layer": 2,
        "controls": [
          {"x@common.legacy_pocket_close_button": {"layer": 3, "$pressed_button_name": "#dc.close"}},
          {"iheader@dc.pocket_header": {"anchor_from": "top_left", "layer": 1, "$dc_text": "inventoryTitle"}},
          {"cheader@dc.pocket_header": {"anchor_from": "top_middle", "layer": 2, "$dc_text": "title"}}
        ]
      }},
      {"inventory_half@arris_cooking_pot.half": {
        "anchor_from": "top_left",
        "controls": [
          {"inner@arris_cooking_pot.half_inner": {
            "controls": [
              {"items@dc.scroll_slots_pocket": {
                "$dc_name": "ipool",
                "$dc_collection": "combined_hotbar_and_inventory_items",
                "$dc_count": 36,
                "$dc_columns": 10,
                "layer": 1,
                "$allow_scrolling_even_when_content_fits": false,
                "$scrolling_pane_size": ["100%", "100%-2px"],
                "$scroll_box_mouse_image_control": "common-classic.button_state_default",
                "$scroll_size": ["8px", "100%"]
              }}
            ]
          }}
        ]
      }},
      {"pot_half@arris_cooking_pot.half": {
        "anchor_from": "top_middle",
        "controls": [
          {"inner@arris_cooking_pot.half_inner": {
            "controls": [
              {"pot_tab@dc.tab": {
                "$dc_value": "page", "$dc_tab": "pot", "$dc_label": "烹饪", "$dc_edge": "left",
                "size": [44, 18], "anchor_from": "top_left", "anchor_to": "top_left", "offset": [0, 0], "layer": 2
              }},
              {"book_tab@dc.tab": {
                "$dc_value": "page", "$dc_tab": "book", "$dc_label": "食谱",
                "size": [44, 18], "anchor_from": "top_left", "anchor_to": "top_left", "offset": [46, 0], "layer": 2
              }},
              {"pot_page@arris_cooking_pot.pocket_pot": {"$dc_visible": ["page", "pot"]}},
              {"book_page@arris_cooking_pot.pocket_book": {"$dc_visible": ["page", "book"], "visible": false}}
            ]
          }}
        ]
      }}
    ]
  },

  // 携带版"烹饪"页：格子 28 一格，成品格 32
  "pocket_pot": {
    "type": "panel",
    "size": [168, 110],
    "offset": [0, 24],
    "layer": 2,
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "controls": [
      {"ingredients@dc.grid_pocket": {
        "$dc_name": "ingredients", "$dc_collection": "ingredients", "$dc_columns": 3, "$dc_rows": 2,
        "$dc_focus": true, "offset": [0, 0], "layer": 2
      }},
      {"heat@arris_cooking_pot.heat": {"offset": [33, 62]}},
      {"progress@arris_cooking_pot.progress": {"offset": [90, 20]}},
      {"preview_frame@arris_cooking_pot.preview_frame": {"offset": [118, 0]}},
      {"preview@dc.item_pocket": {
        "$dc_item": "preview", "anchor_from": "top_left", "anchor_to": "top_left", "offset": [123, 5], "layer": 2
      }},
      {"vessel@dc.slot_pocket": {
        "$dc_name": "vessel", "$dc_collection": "vessel", "$dc_placeholder_size": [14, 14],
        "offset": [90, 54], "layer": 2
      }},
      {"output@dc.slot_large_pocket": {
        "$dc_name": "output", "$dc_collection": "output", "offset": [126, 48], "layer": 2
      }}
    ]
  },

  // 携带版"食谱"页：左边搜索框与列表，右边选中食谱的详情
  "pocket_book": {
    "type": "panel",
    "size": [168, 232],
    "offset": [0, 24],
    "layer": 2,
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "controls": [
      {"search@dc.text_box": {
        "$dc_action": "search", "$dc_value": "search", "$dc_live": true, "$dc_placeholder": "搜索食谱",
        "size": [60, 14], "anchor_from": "top_left", "anchor_to": "top_left", "offset": [0, 0], "layer": 2
      }},
      {"recipe_list@arris_cooking_pot.pocket_list": {"offset": [0, 18]}},
      {"title@arris_cooking_pot.note": {
        "$dc_format": "{bookTitle}", "size": [100, "default"], "text_alignment": "center",
        "anchor_from": "top_left", "anchor_to": "top_left", "offset": [66, 2]
      }},
      {"cells@dc.grid_pocket": {
        "$dc_name": "book_in", "$dc_collection": "book", "$dc_columns": 3, "$dc_rows": 2, "offset": [66, 18], "layer": 2
      }},
      {"book_vessel@dc.slot_pocket": {
        "$dc_name": "book_vessel", "$dc_collection": "book", "$dc_index": 6, "offset": [66, 80], "layer": 2
      }},
      {"book_arrow": {
        "type": "image", "texture": "textures/ui/arrow", "size": [22, 15], "layer": 2,
        "anchor_from": "top_left", "anchor_to": "top_left", "offset": [98, 87]
      }},
      {"book_result@dc.slot_pocket": {
        "$dc_name": "book_result", "$dc_collection": "book", "$dc_index": 7, "offset": [122, 80], "layer": 2
      }},
      {"variant@arris_cooking_pot.note": {
        "$dc_format": "{bookVariant}", "size": [100, "default"], "text_alignment": "center",
        "anchor_from": "top_left", "anchor_to": "top_left", "offset": [66, 112]
      }},
      {"next@dc.button": {
        "$dc_action": "nextVariant", "$dc_label": "换一种配方", "$dc_visible": ["picked", "!=", -1],
        "size": [86, 18], "anchor_from": "top_left", "anchor_to": "top_left", "offset": [66, 126], "layer": 2
      }},
      {"add@dc.button": {
        "$dc_action": "addFood", "$dc_label": "添加食材", "$dc_visible": ["picked", "!=", -1],
        "size": [86, 18], "anchor_from": "top_left", "anchor_to": "top_left", "offset": [66, 148], "layer": 2
      }}
    ]
  },

  "pocket_list": {
    "type": "panel",
    "size": [60, 200],
    "layer": 2,
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "controls": [
      {"list@dc.list": {
        "$dc_items": "recipes", "$dc_value": "picked", "$dc_key": "index", "$dc_action": "pick", "$dc_row_height": 24,
        "$dc_scroll_style": "plain",
        "size": [60, 200], "anchor_from": "top_left", "anchor_to": "top_left", "layer": 2,
        "controls": [
          {"icon@dc.item_classic": {
            "$dc_item": "value", "anchor_from": "left_middle", "anchor_to": "left_middle", "offset": [2, 0]
          }},
          {"name@arris_cooking_pot.note": {
            "$dc_format": "{value:name}", "anchor_from": "left_middle", "anchor_to": "left_middle", "offset": [22, 0]
          }}
        ]
      }}
    ]
  }
}
