{
	"format_version": "1.8.0",
	"animations": {
		"animation.cooking_pot.shelf": {
			"loop": true,
			"override_previous_animation": true,
			"bones": {
				"shelf": {
					"scale": 0
				}
			}
		},
		"animation.cooking_pot.scene": {
			"loop": true,
			"bones": {
				"ladle": {
					"position": ["variable.mod_spoon_x", "variable.mod_spoon_y", "variable.mod_spoon_z"],
					"rotation": ["variable.mod_spoon_rx", "variable.mod_spoon_ry", "variable.mod_spoon_rz"]
