{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "arris:board_dust",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/particle/particles"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "variable.tint_set = 0; variable.tint_r = 0; variable.tint_g = 0; variable.tint_b = 0; variable.count = 0; variable.vx = 0; variable.vy = 0.25; variable.vz = 0; variable.spread = 0.075; variable.base_r = 0.753; variable.base_g = 0.69; variable.base_b = 0.565; variable.base_a = 0.6;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": "variable.count > 0 ? variable.count : 4"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_box": {
        "offset": [
          0,
          0,
          0
        ],
        "half_dimensions": [
          "variable.spread * 0.866",
          "variable.spread * 0.866",
          "variable.spread * 0.866"
        ],
        "direction": [
          "variable.vx + math.random(-1, 1) * math.max(0.0162, 0.2165 * math.sqrt(variable.vx * variable.vx + variable.vy * variable.vy + variable.vz * variable.vz))",
          "variable.vy + math.random(-1, 1) * math.max(0.0162, 0.2165 * math.sqrt(variable.vx * variable.vx + variable.vy * variable.vy + variable.vz * variable.vz))",
          "variable.vz + math.random(-1, 1) * math.max(0.0162, 0.2165 * math.sqrt(variable.vx * variable.vx + variable.vy * variable.vy + variable.vz * variable.vz))"
        ]
      },
      "minecraft:particle_initial_speed": "math.sqrt(variable.vx * variable.vx + variable.vy * variable.vy + variable.vz * variable.vz)",
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(1.0, 2.0)"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          "math.sin((variable.particle_age * 6 + variable.particle_random_2 * 100) * 57.2958) * 0.1125",
          -0.0625,
          "math.cos((variable.particle_age * 6 + variable.particle_random_2 * 100) * 57.2958 * 1.3) * 0.1125"
        ],
        "linear_drag_coefficient": 3.0
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.0046875 + variable.particle_random_1 * 0.0046875",
          "0.0046875 + variable.particle_random_1 * 0.0046875"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "flipbook": {
            "base_UV": [
              56,
              0
            ],
            "size_UV": [
              8,
              8
            ],
            "step_UV": [
              -8,
              0
            ],
            "max_frame": 8,
            "stretch_to_lifetime": true,
            "loop": false
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.tint_set > 0 ? variable.tint_r : variable.base_r",
          "variable.tint_set > 0 ? variable.tint_g : variable.base_g",
          "variable.tint_set > 0 ? variable.tint_b : variable.base_b",
          "(variable.tint_set > 0 ? 1.0 : variable.base_a) * (1 - math.pow(variable.particle_age / variable.particle_lifetime, 2))"
        ]
      }
    }
  }
}
