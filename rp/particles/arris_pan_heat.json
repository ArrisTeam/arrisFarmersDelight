{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "arris:pan_heat",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/handson/particle/heat"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "variable.tint_set = 0; variable.tint_r = 1; variable.tint_g = 1; variable.tint_b = 1; variable.alpha = 0.28; variable.scale = 1; variable.count = 0; variable.life = 0; variable.speed_set = 0; variable.vx = 0; variable.vy = 0; variable.vz = 0;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": "variable.count > 0 ? variable.count : 1"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          0,
          0,
          0
        ],
        "direction": [
          "variable.speed_set > 0 ? variable.vx : 0.0",
          "variable.speed_set > 0 ? variable.vy : 3.0",
          "variable.speed_set > 0 ? variable.vz : 0.0"
        ]
      },
      "minecraft:particle_initial_speed": "math.sqrt(math.pow((variable.speed_set > 0 ? variable.vx : 0.0), 2) + math.pow((variable.speed_set > 0 ? variable.vy : 3.0), 2) + math.pow((variable.speed_set > 0 ? variable.vz : 0.0), 2)) / 16",
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "variable.life > 0 ? variable.life : math.random(0.8, 1.3)"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          "math.sin((variable.particle_age * 5 + variable.particle_random_2 * 100) * 57.2958) * 0.05",
          0.31,
          "math.cos((variable.particle_age * 5 + variable.particle_random_2 * 100) * 57.2958 * 1.3) * 0.05"
        ],
        "linear_drag_coefficient": 0.6
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.01875 + variable.particle_random_1 * 0.0125) * variable.scale * (1 + 0.4 * variable.particle_age / variable.particle_lifetime)",
          "(0.01875 + variable.particle_random_1 * 0.0125) * variable.scale * (1 + 0.4 * variable.particle_age / variable.particle_lifetime)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 8,
          "texture_height": 32,
          "flipbook": {
            "base_UV": [
              0,
              0
            ],
            "size_UV": [
              8,
              8
            ],
            "step_UV": [
              0,
              8
            ],
            "max_frame": 4,
            "stretch_to_lifetime": true,
            "loop": false
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.tint_set > 0 ? variable.tint_r : 1.0",
          "variable.tint_set > 0 ? variable.tint_g : 1.0",
          "variable.tint_set > 0 ? variable.tint_b : 1.0",
          "variable.alpha * math.min(1, variable.particle_age / variable.particle_lifetime / 0.4) * (1 - variable.particle_age / variable.particle_lifetime)"
        ]
      }
    }
  }
}
