{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "arris:pan_smoke",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/handson/particle/pan_smoke"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "variable.tint_set = 0; variable.tint_r = 1; variable.tint_g = 1; variable.tint_b = 1; variable.alpha = 0.345098; variable.scale = 1; variable.count = 0; variable.life = 0; variable.speed_set = 0; variable.vx = 0; variable.vy = 0; variable.vz = 0;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": "variable.count > 0 ? variable.count : 1"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          0,
          0,
          0
        ],
        "direction": [
          "variable.speed_set > 0 ? variable.vx : 0.0",
          "variable.speed_set > 0 ? variable.vy : 4.0",
          "variable.speed_set > 0 ? variable.vz : 0.0"
        ]
      },
      "minecraft:particle_initial_speed": "math.sqrt(math.pow((variable.speed_set > 0 ? variable.vx : 0.0), 2) + math.pow((variable.speed_set > 0 ? variable.vy : 4.0), 2) + math.pow((variable.speed_set > 0 ? variable.vz : 0.0), 2)) / 16",
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "variable.life > 0 ? variable.life : math.random(1.6, 2.4)"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          "math.sin((variable.particle_age * 6 + variable.particle_random_2 * 100) * 57.2958) * 0.375",
          0.25,
          "math.cos((variable.particle_age * 6 + variable.particle_random_2 * 100) * 57.2958 * 1.3) * 0.375"
        ],
        "linear_drag_coefficient": 1.386294
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.05625 + variable.particle_random_1 * 0.025) * variable.scale * (1 + 2.0 * variable.particle_age / variable.particle_lifetime)",
          "(0.05625 + variable.particle_random_1 * 0.025) * variable.scale * (1 + 2.0 * variable.particle_age / variable.particle_lifetime)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 16,
          "texture_height": 192,
          "flipbook": {
            "base_UV": [
              0,
              0
            ],
            "size_UV": [
              16,
              16
            ],
            "step_UV": [
              0,
              16
            ],
            "max_frame": 12,
            "stretch_to_lifetime": true,
            "loop": false
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.tint_set > 0 ? variable.tint_r : 0.784314",
          "variable.tint_set > 0 ? variable.tint_g : 0.776471",
          "variable.tint_set > 0 ? variable.tint_b : 0.760784",
          "variable.alpha * math.min(1, variable.particle_age / variable.particle_lifetime / 0.3) * (1 - math.pow(variable.particle_age / variable.particle_lifetime, 2))"
        ]
      },
      "minecraft:particle_appearance_lighting": {}
    }
  }
}
