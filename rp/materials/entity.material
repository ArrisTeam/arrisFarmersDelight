{
	"materials": {
		"version": "1.0.0",
		"arris_pot_broth:entity": {
			"vertexShader": "shaders/glsl/arris_pot_broth_vertex.glsl",
			"fragmentShader": "shaders/glsl/arris_pot_broth_fragment.glsl",
			"+states": [ "Blending", "DisableDepthWrite", "DisableCulling" ],
			"+defines": [ "USE_SKINNING" ]
		},
		"arris_pot_glow:entity_emissive": {
			"+states": [ "InvertCulling" ]
		},
		"arris_outline:entity_alphablend": {
			"+states": [ "InvertCulling" ]
		}
	}
}
