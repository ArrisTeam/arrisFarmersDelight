{
	"format_version": "1.8.0",
	"render_controllers": {
		"controller.render.arris_cooking_pot": {
			"geometry": "Geometry.default",
			"materials": [
				{
					"*": "Material.default"
				}
			],
			"textures": [
				"Texture.default"
			],
			"part_visibility": [
				{
					"broth": false
				},
				{
					"ladle_glow": false
				},
				{
					"pot_glow": false
				},
				{
					"lid": "variable.mod_open < 0.5"
				}
			]
		},
		"controller.render.arris_cooking_pot_glow": {
			"geometry": "Geometry.default",
			"materials": [
				{
					"*": "Material.glow"
				}
			],
			"textures": [
				"Texture.glow"
			],
			"part_visibility": [
				{
					"*": false
				},
				{
					"ladle_glow": "variable.mod_open > 0.5 && variable.mod_spoon_lit > 0.5"
				},
				{
					"pot_glow": "variable.mod_open > 0.5 && variable.mod_pot_lit > 0.5"
				}
			]
		},
		"controller.render.arris_cooking_pot_broth": {
			"geometry": "Geometry.default",
			"materials": [
				{
					"*": "Material.broth"
				}
			],
			"textures": [
				"Texture.broth"
			],
			"part_visibility": [
				{
					"*": false
				},
				{
					"broth": "variable.mod_open > 0.5"
				}
			]
		}
	}
}
